# Catalog snapshot cache
# 900 = 15 minutes. 0 = never expires automatically; use manual refresh/clear.
CATALOG_SNAPSHOT_TTL_SECONDS=900

# Optional. Needed only if you want to refresh/clear catalog cache through the public URL.
# Local curl directly to 127.0.0.1:<nitro-port> works without this key.
# Generate your own long random value; do not commit the real key.
CATALOG_CACHE_RESET_KEY=
